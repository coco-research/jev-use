#!/bin/sh
# The voice hook - the file CoCo Voice runs for every transcript.
#
#   settings_store.json:
#     "paste_method": "external_script",
#     "external_script_path": "<wherever you cloned this>/scripts/voice-hook"
#
# READ THIS FIRST: `external_script` REPLACES typing. The moment it is switched on,
# dictation stops working unless this hook types the text - which it does, by pressing
# Cmd+V. If the hook is missing or broken, dictation is broken with it. There is no
# partial setting.
#
# THIS FILE IS NOT THE CONFIGURATION. It used to be, and that was the problem: settings
# spread over a wrapper script, some environment variables and a JSON file is settings
# nobody can find. Everything now lives in one place, with one command to change it:
#
#   jev-config                 the settings menu
#   jev-config doctor          check the whole chain
#   cat "$(jev-config path)"   the file itself
#
# What is left here is the one thing a wrapper must do: forward the transcript exactly as
# it was received.
#
#   - `exec` keeps the process count at one, so the app waits on the real hook
#   - "$@" forwards the transcript as a single argument: no word splitting, no globbing,
#     no shell parsing of what you said
#   - the hook always exits 0, because a non-zero exit is reported as a paste failure
#
# The two environment variables below still work, for a one-off or a script. They are
# overrides, not the place to configure things:
#
#   JEV_VOICE_HOOK_BIN   the hook binary
#                        default: $HOME/.local/bin/jev-voice-hook
#   JEV_SETTINGS_FILE    the settings file
#                        default: ${XDG_CONFIG_HOME:-$HOME/.config}/jev-use/settings.json
#
# Try it without speaking, safely - this decides and prints, and touches nothing:
#
#   scripts/voice-hook --dry-run "Emma, open a new tab"
#
# The log is `voice.log` in the settings, by default ~/Library/Logs/jev-voice-hook.log:
# one line per utterance, and one per backgrounded run with its exit code.

HOOK_BIN="${JEV_VOICE_HOOK_BIN:-$HOME/.local/bin/jev-voice-hook}"

exec "$HOOK_BIN" "$@"
