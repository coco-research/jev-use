#!/usr/bin/env python3
"""usage-check - where the tokens and the money are actually going.

Two questions, answered from real data:

  WHERE DID THE TOKENS GO?   read from PI Desktop's own turn log (pi.sqlite)
  WHERE DID THE MONEY GO?    balance deltas between runs, not invented prices

Usage:
    usage-check                 tokens by model, last 7 days
    usage-check --live          also probe wallets and route health
    usage-check --days 30       widen the window
    usage-check --json          machine-readable
    usage-check --history       every recorded wallet snapshot

WHY BALANCE DELTAS AND NOT PRICES:
    Every route here is either flat-rate or priced per token by a vendor whose
    price list we do not control. Rather than hardcode a number that silently goes
    stale, this records the wallet balance on each --live run and reports the
    difference. A delta cannot be wrong; a hardcoded price can.

BRING YOUR OWN KEYS. This tool ships with NO providers in it. It knows about your
wallets only because you point it at them, in a config file that stays on your machine
and is never committed:

    ~/.config/jev-use/usage-check.json     (template: scripts/usage-check.example.json)

Keys are read from the environment, or from an env-style file you name. A provider whose
key is missing is reported as "no key" rather than guessed at. Every path is overridable:

    JEV_USAGE_CONFIG   default ~/.config/jev-use/usage-check.json
    JEV_USAGE_DB       default ~/.pi-desktop/pi.sqlite
    JEV_KEYS_FILE      default ~/.secrets/ai-keys.env
    JEV_AUTH_FILE      default ~/.pi/agent/auth.json
    JEV_USAGE_STATE    default ~/.pi/agent/usage-history.json

Exit codes: 0 fine, 1 something needs attention, 2 the check itself failed.
"""
from __future__ import annotations

import argparse
import json
import os
import sqlite3
import ssl
import subprocess
import sys
import time
import urllib.parse
import urllib.request
from collections import defaultdict
from datetime import datetime, timedelta
from pathlib import Path

HOME = Path.home()


def env_path(var: str, default: Path) -> Path:
    """A path the user can move without editing this file."""
    return Path(os.environ.get(var) or default)


SETTINGS = env_path("JEV_SETTINGS_FILE", HOME / ".config" / "jev-use" / "settings.json")
CONFIG = env_path("JEV_USAGE_CONFIG", HOME / ".config" / "jev-use" / "usage-check.json")
DB = env_path("JEV_USAGE_DB", HOME / ".pi-desktop" / "pi.sqlite")
SECRETS = env_path("JEV_KEYS_FILE", HOME / ".secrets" / "ai-keys.env")
AUTH = env_path("JEV_AUTH_FILE", HOME / ".pi" / "agent" / "auth.json")
STATE = env_path("JEV_USAGE_STATE", HOME / ".pi" / "agent" / "usage-history.json")

GREEN, RED, YELLOW, DIM, BOLD, RESET = (
    "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[1m", "\033[0m"
)


def ssl_ctx():
    """This Mac's Python has no default CA bundle."""
    for c in ("/etc/ssl/cert.pem", "/opt/homebrew/etc/openssl@3/cert.pem"):
        if Path(c).exists():
            try:
                return ssl.create_default_context(cafile=c)
            except ssl.SSLError:
                pass
    try:
        import certifi
        return ssl.create_default_context(cafile=certifi.where())
    except Exception:  # noqa: BLE001
        return ssl.create_default_context()


CTX = ssl_ctx()


def read_json(p: Path) -> dict:
    try:
        return json.loads(p.read_text())
    except (OSError, json.JSONDecodeError):
        return {}


def read_env() -> dict:
    out = {}
    try:
        for line in SECRETS.read_text(errors="replace").splitlines():
            s = line.strip()
            if not s or s.startswith("#") or "=" not in s:
                continue
            k, _, v = s.partition("=")
            out[k.strip()] = v.strip().strip('"').strip("'")
    except OSError:
        pass
    return out


def read_auth() -> dict:
    try:
        return json.loads(AUTH.read_text())
    except (OSError, json.JSONDecodeError):
        return {}


# ── tokens: from PI Desktop's own turn log ─────────────────────────────────

def token_usage(days: int) -> dict:
    if not DB.exists():
        return {"error": f"{DB} not found"}
    since = int((datetime.now() - timedelta(days=days)).timestamp() * 1000)
    try:
        con = sqlite3.connect(f"file:{DB}?mode=ro", uri=True, timeout=20)
    except sqlite3.Error as exc:
        return {"error": str(exc)}

    by_model: dict[str, dict] = defaultdict(lambda: {"turns": 0, "in": 0, "out": 0, "last": 0})
    by_day: dict[str, dict] = defaultdict(lambda: {"in": 0, "out": 0, "turns": 0})
    errors: dict[str, int] = defaultdict(int)
    total = {"in": 0, "out": 0, "turns": 0}
    cache = {"read": 0, "reasoning": 0}

    try:
        q = ("select model_id, input_tokens, output_tokens, started_at, error_code, usage_json "
             "from turns where started_at >= ?")
        for model, i, o, ts, err, uj in con.execute(q, (since,)):
            i = i or 0
            o = o or 0
            if err:
                errors[err] += 1
            if not i and not o:
                continue
            m = str(model or "?")
            e = by_model[m]
            e["turns"] += 1
            e["in"] += i
            e["out"] += o
            e["last"] = max(e["last"], ts or 0)
            d = datetime.fromtimestamp((ts or 0) / 1000).strftime("%Y-%m-%d")
            by_day[d]["in"] += i
            by_day[d]["out"] += o
            by_day[d]["turns"] += 1
            total["in"] += i
            total["out"] += o
            total["turns"] += 1
            if uj:
                try:
                    u = json.loads(uj)
                    cache["read"] += int(u.get("cacheReadTokens") or 0)
                    cache["reasoning"] += int(u.get("reasoningTokens") or 0)
                except (ValueError, TypeError):
                    pass
    finally:
        con.close()

    return {"by_model": dict(by_model), "by_day": dict(by_day),
            "errors": dict(errors), "total": total, "cache": cache, "days": days}


# ── wallets: balance endpoints that actually exist ─────────────────────────

def fetch_json(url: str, key: str, timeout: int = 12):
    req = urllib.request.Request(url, headers={
        "Authorization": f"Bearer {key}",
        "Accept": "application/json",
        "User-Agent": "usage-check/1.0 (+local)",
    })
    with urllib.request.urlopen(req, timeout=timeout, context=CTX) as r:
        return json.load(r)


def apply_paths(paths: dict) -> None:
    """Let the settings file move a path, without re-editing this script.

    Precedence matches everything else: an environment variable is already in the module
    constants and wins over the file.
    """
    global DB, SECRETS, AUTH, STATE
    names = {"db": ("DB", "JEV_USAGE_DB"), "keys_file": ("SECRETS", "JEV_KEYS_FILE"),
             "auth_file": ("AUTH", "JEV_AUTH_FILE"), "state": ("STATE", "JEV_USAGE_STATE")}
    for name, (const, var) in names.items():
        value = paths.get(name)
        if value and not os.environ.get(var):
            globals()[const] = Path(value).expanduser()



def load_config() -> dict:
    """The operator's own providers, from the ONE settings file.

    `~/.config/jev-use/settings.json` is where every setting lives, the `usage` section
    here - settings spread over several files are settings nobody can find. The older
    per-tool file still works, so a machine configured before settings.json existed does
    not break, but it is the fallback and not the destination.
    """
    doc = read_json(SETTINGS) or {}
    usage = doc.get("usage") or {}
    if usage:
        return {
            "wallets": usage.get("providers") or [],
            "gateway": usage.get("gateway"),
            "paths": {k: usage.get(k) for k in ("db", "keys_file", "auth_file", "state")},
        }
    return read_json(CONFIG) or {}

def wallet_balances(env: dict, cfg: dict) -> list[dict]:
    """Probe the wallets YOU configured, and only those.

    Each entry names an endpoint, the field holding the balance, and where the key comes
    from. Two shapes are supported because vendors differ: `balance_field` for a flat
    number, and `credits` for the total/used pair that OpenRouter-style APIs return.

    Entries sharing a `group` are one wallet behind several keys (common: one account,
    one key per product). Tagging them keeps a reader from adding the same money twice.
    """
    wallets = cfg.get("wallets") or []
    if not wallets:
        return []

    auth = read_auth()
    def resolve_key(spec: dict):
        if spec.get("key_env"):
            return env.get(spec["key_env"]) or os.environ.get(spec["key_env"]) or None
        if spec.get("auth_file_key"):
            return (auth.get(spec["auth_file_key"]) or {}).get("key") or None
        return None

    out: list[dict] = []
    for spec in wallets:
        name = spec.get("name") or spec.get("url") or "unnamed wallet"
        try:
            key = resolve_key(spec)
            if not key:
                out.append({"name": name, "ok": False, "detail": "no key"})
                continue
            d = fetch_json(spec["url"], key)
            if spec.get("credits"):
                granted = float(d.get("total_credits") or 0)
                used = float(d.get("total_usage") or 0)
                entry = {"name": name, "ok": True, "unit": spec.get("unit", "USD"),
                         "balance": granted - used, "spent": used, "granted": granted}
            else:
                # A field, or a list of candidates: vendors disagree on the name, and
                # the first present one is the balance.
                fields = spec.get("balance_field", "balance")
                fields = [fields] if isinstance(fields, str) else fields
                raw = next((d[f] for f in fields if d.get(f) is not None), 0)
                entry = {"name": name, "ok": True, "unit": spec.get("unit", "USD"),
                         "balance": float(raw or 0)}
            if spec.get("group"):
                entry["shared"] = spec["group"]
            if spec.get("note"):
                entry["note"] = spec["note"]
            out.append(entry)
        except Exception as exc:  # noqa: BLE001
            out.append({"name": name, "ok": False, "detail": f"{type(exc).__name__}"})
    return out


def route_health(env: dict, cfg: dict) -> list[dict]:
    """Ask your gateway which of your routes can complete right now.

    Off unless you name a gateway: this is the one probe that would otherwise send a
    request to a service nobody configured.
    """
    gw = cfg.get("gateway") or {}
    base = (gw.get("base_url") or "").rstrip("/")
    models = gw.get("models") or []
    key_env = gw.get("key_env") or ""
    key = env.get(key_env) or os.environ.get(key_env, "") if key_env else ""
    if not base or not models or not key:
        return []
    out = []
    for m in models:
        entry = {"model": m, "state": "unknown", "detail": ""}
        try:
            url = f"{base}/health?model={urllib.parse.quote(m)}"
            req = urllib.request.Request(url, headers={"Authorization": f"Bearer {key}"})
            with urllib.request.urlopen(req, timeout=60) as r:
                d = json.load(r)
            bad = d.get("unhealthy_endpoints") or []
            good = d.get("healthy_endpoints") or []
            if bad and not good:
                entry |= {"state": "dead",
                          "detail": str((bad[0] or {}).get("error") or "")[:90]}
            else:
                entry |= {"state": "ok", "detail": f"{len(good)} endpoint(s)"}
        except urllib.error.HTTPError as exc:
            raw = exc.read().decode(errors="replace")
            detail = raw[:200]
            try:
                doc = json.loads(raw)
                bad = doc.get("unhealthy_endpoints") or []
                if bad:
                    detail = str((bad[0] or {}).get("error") or detail)
            except Exception:  # noqa: BLE001
                pass
            entry |= {"state": "dead", "detail": " ".join(detail.split())[:90]}
        except Exception as exc:  # noqa: BLE001
            entry |= {"state": "unknown", "detail": type(exc).__name__}
        out.append(entry)
    return out
    models = ["deepseek-v4.1-flash", "deepseek-v4.1-flash-cc2", "deepseek-v4.1-flash-akf",
              "GLM-5.3-Flash", "gpt-6-astra", "gpt-6-astra-akf"]
    out = []
    for m in models:
        entry = {"model": m, "state": "unknown", "detail": ""}
        try:
            url = f"http://127.0.0.1:4010/health?model={urllib.parse.quote(m)}"
            req = urllib.request.Request(url, headers={"Authorization": f"Bearer {mk}"})
            with urllib.request.urlopen(req, timeout=60) as r:
                d = json.load(r)
            bad = d.get("unhealthy_endpoints") or []
            good = d.get("healthy_endpoints") or []
            if bad and not good:
                entry |= {"state": "dead",
                          "detail": str((bad[0] or {}).get("error") or "")[:90]}
            else:
                entry |= {"state": "ok", "detail": f"{len(good)} endpoint(s)"}
        except urllib.error.HTTPError as exc:
            raw = exc.read().decode(errors="replace")
            detail = raw[:200]
            try:
                doc = json.loads(raw)
                bad = doc.get("unhealthy_endpoints") or []
                if bad:
                    detail = str((bad[0] or {}).get("error") or detail)
            except Exception:  # noqa: BLE001
                pass
            entry |= {"state": "dead", "detail": " ".join(detail.split())[:90]}
        except Exception as exc:  # noqa: BLE001
            entry |= {"state": "unknown", "detail": type(exc).__name__}
        out.append(entry)
    return out


# ── history: balance snapshots, so spend is a measurement ──────────────────

def load_history() -> list:
    try:
        return json.loads(STATE.read_text())
    except (OSError, json.JSONDecodeError):
        return []


def save_snapshot(wallets: list[dict]) -> None:
    hist = load_history()
    hist.append({
        "at": int(time.time()),
        "wallets": [{"name": w["name"], "balance": w.get("balance")} for w in wallets if w.get("ok")],
    })
    hist = hist[-500:]  # keep it bounded
    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text(json.dumps(hist, indent=1) + "\n")


def spend_deltas() -> list[dict]:
    """Balance change between the oldest and newest snapshot per wallet."""
    hist = load_history()
    if len(hist) < 2:
        return []
    first, last = hist[0], hist[-1]
    span_h = max(0.01, (last["at"] - first["at"]) / 3600)
    a = {w["name"]: w["balance"] for w in first["wallets"] if w.get("balance") is not None}
    b = {w["name"]: w["balance"] for w in last["wallets"] if w.get("balance") is not None}
    out = []
    for name in a:
        if name in b:
            spent = a[name] - b[name]
            out.append({"name": name, "spent": spent, "hours": span_h,
                        "per_hour": spent / span_h if span_h else 0})
    return out


# ── report ─────────────────────────────────────────────────────────────────

def human(n: int) -> str:
    if n >= 1_000_000:
        return f"{n/1_000_000:.1f}M"
    if n >= 1_000:
        return f"{n/1_000:.0f}k"
    return str(n)


def main() -> int:
    ap = argparse.ArgumentParser(description="Where the tokens and money go.")
    ap.add_argument("--days", type=int, default=7)
    ap.add_argument("--live", action="store_true", help="probe wallets and route health")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--history", action="store_true", help="every recorded snapshot")
    args = ap.parse_args()

    env = read_env()
    cfg = load_config()
    apply_paths(cfg.get("paths") or {})
    tok = token_usage(args.days)
    if "error" in tok:
        print(f"usage-check: {tok['error']}", file=sys.stderr)
        return 2

    wallets = wallet_balances(env, cfg) if args.live else []
    health = route_health(env, cfg) if args.live else []
    if args.live and wallets:
        save_snapshot(wallets)
    deltas = spend_deltas()

    if args.history:
        hist = load_history()
        print(f"{len(hist)} snapshot(s) in {STATE}\n")
        for h in hist[-20:]:
            t = datetime.fromtimestamp(h["at"]).strftime("%b %d %H:%M")
            ws = ", ".join(f"{w['name']}={w['balance']}" for w in h["wallets"] if w.get("balance") is not None)
            print(f"  {t}  {ws}")
        return 0

    if args.json:
        print(json.dumps({"tokens": tok, "wallets": wallets, "routeHealth": health,
                          "deltas": deltas}, indent=2))
        return 0

    # ── tokens ────────────────────────────────────────────────────────────
    t = tok["total"]
    print(f"\n{BOLD}TOKENS{RESET}  {DIM}last {args.days} days, from PI Desktop's turn log{RESET}")
    print(f"  {human(t['in'])} in   {human(t['out'])} out   {t['turns']:,} turns")
    if tok["cache"]["read"]:
        print(f"  {DIM}cache reads: {human(tok['cache']['read'])}   reasoning: {human(tok['cache']['reasoning'])}{RESET}")
    print()
    print(f"  {'model':34s} {'turns':>6} {'in':>8} {'out':>8}  last used")
    print("  " + "-" * 76)
    for m, v in sorted(tok["by_model"].items(), key=lambda kv: -(kv[1]["in"] + kv[1]["out"])):
        last = datetime.fromtimestamp(v["last"] / 1000).strftime("%b %d %H:%M") if v["last"] else "-"
        print(f"  {m[:33]:34s} {v['turns']:>6} {human(v['in']):>8} {human(v['out']):>8}  {last}")

    if args.days > 1 and tok["by_day"]:
        print()
        print(f"  {BOLD}by day{RESET}")
        for d in sorted(tok["by_day"])[-7:]:
            v = tok["by_day"][d]
            bar = "#" * min(40, int((v["in"] + v["out"]) / max(1, max(
                x["in"] + x["out"] for x in tok["by_day"].values())) * 40))
            print(f"    {d}  {human(v['in'] + v['out']):>7}  {DIM}{bar}{RESET}")

    # ── wallets ───────────────────────────────────────────────────────────
    if args.live:
        print()
        print(f"{BOLD}WALLETS{RESET}")
        if not wallets:
            # Distinguish "you configured nothing" from "your providers are down",
            # because the second one is alarming and this one is a setup step.
            print(f"  {DIM}none configured - {CONFIG} lists the wallets to probe"
                  f"{RESET}")
        seen_wallet: dict[str, float] = {}
        for w in wallets:
            if w.get("ok"):
                bal = w.get("balance", 0)
                shared = w.get("shared")
                if shared and shared in seen_wallet:
                    # Same money already printed. Say which keys share it, once.
                    print(f"  {w['name']:22s} {DIM}same wallet as above"
                          f" ({shared} {bal:,.2f}){RESET}")
                    continue
                if shared:
                    seen_wallet[shared] = bal
                line = f"  {w['name']:22s} {w.get('unit','')} {bal:>10,.2f}"
                if w.get("granted"):
                    line += f"  {DIM}of {w['granted']:,.0f} granted{RESET}"
                if w.get("note"):
                    line += f"  {DIM}{w['note']}{RESET}"
                print(line)
            else:
                print(f"  {w['name']:22s} {RED}unavailable{RESET}  {DIM}{w.get('detail','')}{RESET}")

        if deltas:
            print()
            print(f"  {BOLD}spend since the first snapshot{RESET}")
            shown: set[str] = set()
            for d in deltas:
                if abs(d["spent"]) < 0.0001:
                    continue
                # Keys that share a wallet share a delta: print the money once, under
                # the group name the config declared.
                key = d.get("shared") or d["name"]
                if key in shown:
                    continue
                shown.add(key)
                print(f"    {d['name']:22s} -{d['spent']:,.2f} over {d['hours']:.1f}h"
                      f"  {DIM}({d['per_hour']:,.3f}/h){RESET}")

        # ── routes ────────────────────────────────────────────────────────
        if not health:
            print(f"  {DIM}none configured - add a \"gateway\" section to {CONFIG}"
                  f"{RESET}")
        dead = []
        for h in health:
            if h["state"] == "ok":
                print(f"  {GREEN}ok  {RESET} {h['model']:26s} {DIM}{h['detail']}{RESET}")
            elif h["state"] == "dead":
                print(f"  {RED}DEAD{RESET} {h['model']:26s} {DIM}{h['detail']}{RESET}")
                dead.append(h["model"])
            else:
                print(f"  {YELLOW}?   {RESET} {h['model']:26s} {DIM}{h['detail']}{RESET}")

        print()
        if dead:
            print(f"{YELLOW}{BOLD}ATTENTION{RESET}  {len(dead)} route(s) cannot complete:")
            for d in dead:
                print(f"    {d}")
            flat_dead = [d for d in dead if "akf" not in d and "cc2" in d or d == "deepseek-v4.1-flash"]
            if flat_dead and any("akf" not in d for d in dead):
                print(f"  {DIM}if a flat-rate route is dead, every call is landing on the{RESET}")
                print(f"  {DIM}pay-per-use route instead. That is the expensive failure mode.{RESET}")

    if tok["errors"]:
        print()
        print(f"{BOLD}ERRORS{RESET}  {DIM}in the window{RESET}")
        for code, n in sorted(tok["errors"].items(), key=lambda kv: -kv[1]):
            mark = RED if code in ("PROVIDER_ERROR", "PROVIDER_UNAUTHORIZED") else DIM
            print(f"  {mark}{code:38s}{RESET} {n}")

    print()
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except SystemExit:
        raise
    except Exception as exc:  # noqa: BLE001
        print(f"usage-check: {type(exc).__name__}: {exc}", file=sys.stderr)
        raise SystemExit(2)
